# Copier vers .env ou utiliser .env.local (Symfony charge .env puis .env.local).
# Port HTTP local : 8888 (symfony server:start, voir .symfony.local.yaml). Docker Compose expose aussi :8888.

###> doctrine/doctrine-bundle ###
# Développement local — PostgreSQL installé sur la machine (port 5432 par défaut)
DATABASE_URL="postgresql://collab:collab@127.0.0.1:5432/collaboration_db?serverVersion=16&charset=utf8"

# Si tu préfères le Postgres du docker-compose sur l’hôte (port mappé 5434) :
# DATABASE_URL="postgresql://collab:collab@127.0.0.1:5434/collaboration_db?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=projetpidev
